{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "BhuvaneshsfTest"
		},
		"AzureSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSql'"
		},
		"Storagelinkedlist_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Storagelinkedlist'"
		},
		"AzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adminadmins.database.windows.net"
		},
		"AzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "PracticeDB"
		},
		"AzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin12"
		},
		"GitLinked_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"Storagelinkedlist_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://bhuvaneshstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "BhuvaneshsfTest_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSql_password": {
						"value": "[parameters('AzureSql_password')]"
					},
					"Storagelinkedlist_accountKey": {
						"value": "[parameters('Storagelinkedlist_accountKey')]"
					},
					"AzureSql_properties_typeProperties_server": {
						"value": "[parameters('AzureSql_properties_typeProperties_server')]"
					},
					"AzureSql_properties_typeProperties_database": {
						"value": "[parameters('AzureSql_properties_typeProperties_database')]"
					},
					"AzureSql_properties_typeProperties_userName": {
						"value": "[parameters('AzureSql_properties_typeProperties_userName')]"
					},
					"GitLinked_properties_typeProperties_url": {
						"value": "[parameters('GitLinked_properties_typeProperties_url')]"
					},
					"Storagelinkedlist_properties_typeProperties_url": {
						"value": "[parameters('Storagelinkedlist_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "BhuvaneshsfTest_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'BhuvaneshsfTest_ArmTemplate_0')]"
			]
		}
	]
}